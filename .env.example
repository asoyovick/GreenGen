# Copy to .env for local development. Do NOT commit .env or credentials.
# Real NASA data access (required only for authenticated downloads/real pipeline runs)
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# NASA services (defaults are usually fine; override if needed)
# CMR_BASE_URL=https://cmr.earthdata.nasa.gov
# EARTHDATA_LOGIN_URL=https://urs.earthdata.nasa.gov

# Application (current prototype)
# APP_HOST=127.0.0.1
# APP_PORT=8000
# FRONTEND_PORT=5173

# Backend (Go) / database (set when backend components are implemented)
# APP_ENV=development
# HTTP_PORT=8080
# DATABASE_URL=postgresql://user:password@localhost:5432/greengen
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=greengen
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=20s
# REQUEST_TIMEOUT=30s
# PYTHON_ENGINE_URL=http://localhost:8090
# PYTHON_ENGINE_TIMEOUT=120s
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# GO_API_BASE_URL=http://localhost:8080
# LOG_LEVEL=info
